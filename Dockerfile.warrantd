# Stage 1: Build React 19 + TypeScript 5 + Tailwind Console
FROM node:22-alpine AS web-builder
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# Stage 2: Compile Pure-Go warrantd (embedding /web/dist + SQL migrations + OPA Rego) and warrant CLI
FROM golang:1.26-alpine AS go-builder
ENV GOTOOLCHAIN=auto
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=web-builder /web/dist ./web/dist
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/warrantd ./cmd/warrantd && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/warrant ./cmd/warrant && \
    mkdir -p /out/warrant-anchor

# Stage 3: Distroless Non-Root Production Runtime
FROM gcr.io/distroless/static:nonroot
COPY --from=go-builder /out/warrantd /warrantd
COPY --from=go-builder /out/warrant /warrant
COPY --from=go-builder --chown=65532:65532 /out/warrant-anchor /var/lib/warrant-anchor
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/warrantd"]
