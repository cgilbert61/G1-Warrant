{"$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json", "version": "2.1.0", "runs": [{"tool": {"driver": {"name": "Checkov", "version": "3.4.5", "informationUri": "https://checkov.io", "rules": [{"id": "CKV_K8S_35", "name": "Prefer using secrets as files over secrets as environment variables", "shortDescription": {"text": "Prefer using secrets as files over secrets as environment variables"}, "fullDescription": {"text": "Prefer using secrets as files over secrets as environment variables"}, "help": {"text": "Prefer using secrets as files over secrets as environment variables\nResource: Deployment.g1-warrant-system.g1-warrantd"}, "defaultConfiguration": {"level": "error"}, "helpUri": "https://docs.prismacloud.io/en/enterprise-edition/policy-reference/kubernetes-policies/kubernetes-policy-index/bc-k8s-33"}], "organization": "bridgecrew"}}, "results": [{"ruleId": "CKV_K8S_35", "ruleIndex": 0, "level": "error", "attachments": [], "message": {"text": "Prefer using secrets as files over secrets as environment variables"}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "tf/k8s/warrantd-deployment.yaml"}, "region": {"startLine": 1, "endLine": 84, "snippet": {"text": "apiVersion: apps/v1\nkind: Deployment\nmetadata:\n  name: g1-warrantd\n  namespace: g1-warrant-system\n  labels:\n    app.kubernetes.io/name: g1-warrantd\n    app.kubernetes.io/part-of: g1-warrant\n    tier: deterministic-control-plane\nspec:\n  replicas: 3\n  strategy:\n    type: RollingUpdate\n    rollingUpdate:\n      maxSurge: 1\n      maxUnavailable: 0\n  selector:\n    matchLabels:\n      app: g1-warrantd\n  template:\n    metadata:\n      labels:\n        app: g1-warrantd\n    spec:\n      automountServiceAccountToken: false\n      securityContext:\n        runAsNonRoot: true\n        runAsUser: 65532\n        runAsGroup: 65532\n        fsGroup: 65532\n        seccompProfile:\n          type: RuntimeDefault\n      containers:\n        - name: warrantd\n          image: ghcr.io/cgilbert61/g1-warrent/warrantd@sha256:6b86b273ff34fce19d6b804eff5a3f5747ada4eaa22f1d49c01e52ddb7875b4b\n          imagePullPolicy: Always\n          env:\n            - name: WARRANT_LISTEN_ADDR\n              value: \":8080\"\n            - name: WARRANT_EXTRACTOR_URL\n              value: \"http://g1-warrant-extractor.g1-warrant-system.svc.cluster.local:8090\"\n            - name: WARRANT_FEED_MODE\n              value: \"offline\"\n            - name: WARRANT_ENABLE_TEST_SMARTCARDS\n              value: \"false\"\n            - name: WARRANT_DB_DSN\n              valueFrom:\n                secretKeyRef:\n                  name: g1-warrant-secrets\n                  key: database-dsn\n          ports:\n            - name: http-console\n              containerPort: 8080\n              protocol: TCP\n          resources:\n            requests:\n              cpu: \"500m\"\n              memory: \"512Mi\"\n            limits:\n              cpu: \"2000m\"\n              memory: \"1Gi\"\n          securityContext:\n            allowPrivilegeEscalation: false\n            readOnlyRootFilesystem: true\n            runAsNonRoot: true\n            runAsUser: 65532\n            runAsGroup: 65532\n            seccompProfile:\n              type: RuntimeDefault\n            capabilities:\n              drop: [\"ALL\"]\n          livenessProbe:\n            httpGet:\n              path: /healthz\n              port: 8080\n            initialDelaySeconds: 5\n            periodSeconds: 10\n          readinessProbe:\n            httpGet:\n              path: /healthz\n              port: 8080\n            initialDelaySeconds: 3\n            periodSeconds: 5\n---\n"}}}}]}]}]}