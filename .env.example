# G1-Warrant Runtime Threat & Scanner Feed Configuration
# Default is 'offline' for air-gapped federal enclaves and deterministic CI tests.
# Set WARRANT_FEED_MODE=live to enable $0 real-world CISA KEV + Google OSV.dev polling.
WARRANT_FEED_MODE=offline

# Live US Government CISA Known Exploited Vulnerabilities (KEV) Feed
WARRANT_CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
WARRANT_KEV_POLL_INTERVAL=1h

# Optional Free Google OSV.dev SBOM PURL Batch Vulnerability Lookup
WARRANT_OSV_API_URL=https://api.osv.dev/v1/querybatch

# Optional Real Open-Source Trivy Container Scanner Sidecar (--profile live-feeds)
WARRANT_TRIVY_ENABLED=false
WARRANT_TRIVY_TARGETS=curlimages/curl:8.3.0=fulfillment-worker,nginx:1.24.0-alpine=checkout-cart-svc
WARRANT_TRIVY_MAX_FINDINGS=2
WARRANT_TRIVY_SCAN_INTERVAL_SEC=3600
