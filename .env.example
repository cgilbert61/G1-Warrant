# G1-Warrant Environment Template
# Copy to .env and generate unique random secrets (or run `make init-env` for sandbox setup):
#   PW="$(openssl rand -hex 24)"
POSTGRES_USER=warrant
POSTGRES_DB=warrant
POSTGRES_PASSWORD=
DATABASE_URL=

# Required in live/Kubernetes posture (WARRANT_POSTURE=live or WARRANT_CLUSTER_DRIVER=kubernetes):
WARRANT_PUBLISHER_PUBLIC_KEY_B64=
WARRANT_RULEPACK_PUBLIC_KEY_B64=

# Strongly recommended in live/Kubernetes posture for EXTERNAL_NOTARY transparency anchoring:
WARRANT_EXTERNAL_ANCHOR_URL=

# Out-of-band pinned kernel public key export path for air-gapped 3PAO offline verification (WN-4 / WN-5):
WARRANT_KERNEL_PUBLIC_KEY_EXPORT_PATH=

# -----------------------------------------------------------------------------
# WN-7 Inbound Finder Intake Authentication (Zero-Egress Push Model)
# Scanners (Qualys VMDR, Tenable.io/sc, Rapid7 InsightVM, Trivy, Gitleaks) push
# untrusted exports to POST /api/v1/intake/{qualys,tenable,rapid7,sarif,secrets}
# authenticated with X-Warrant-Intake-Token. Warrant holds ZERO scanner API keys.
# -----------------------------------------------------------------------------
WARRANT_INTAKE_TOKEN=

# -----------------------------------------------------------------------------
# WN-8 Outbound Distributor Translator Endpoints & Bearer Credentials
# (See docs/vendor_integration_reference.md for exact API routes & proof fence.
#  When unset, translators operate in deterministic simulated-results mode.)
# -----------------------------------------------------------------------------
# 1. Containers & GitOps (k8s-cilium-native uses WARRANT_CLUSTER_DRIVER / WARRANT_KUBE_API_URL)
WARRANT_ARGOCD_URL=
WARRANT_ARGOCD_TOKEN=
WARRANT_FLUX_URL=
WARRANT_FLUX_TOKEN=

# 2. Microsoft Estate (Graph API / ConfigMgr AdminService / WSUS)
WARRANT_MS_INTUNE_URL=
WARRANT_MS_INTUNE_TOKEN=
WARRANT_MS_MECM_URL=
WARRANT_MS_MECM_TOKEN=
WARRANT_MS_WSUS_URL=
WARRANT_MS_WSUS_TOKEN=

# 3. Linux Automation (Ansible Automation Platform / Red Hat Satellite)
WARRANT_ANSIBLE_AWX_URL=
WARRANT_ANSIBLE_AWX_TOKEN=
WARRANT_REDHAT_SATELLITE_URL=
WARRANT_REDHAT_SATELLITE_TOKEN=

# 4. Apple Estate (Jamf Pro)
WARRANT_JAMF_PRO_URL=
WARRANT_JAMF_PRO_TOKEN=

# 5. Cloud-Native Patchers (AWS SSM / Azure Update Manager / GCP OS Config)
WARRANT_AWS_SSM_URL=
WARRANT_AWS_SSM_TOKEN=
WARRANT_AZURE_UPDATE_URL=
WARRANT_AZURE_UPDATE_TOKEN=
WARRANT_GCP_OSCONFIG_URL=
WARRANT_GCP_OSCONFIG_TOKEN=

# 6. Multi-Platform Endpoint Patching (Tanium / Ivanti Neurons / Automox)
WARRANT_TANIUM_URL=
WARRANT_TANIUM_TOKEN=
WARRANT_IVANTI_URL=
WARRANT_IVANTI_TOKEN=
WARRANT_AUTOMOX_URL=
WARRANT_AUTOMOX_TOKEN=

# -----------------------------------------------------------------------------
# N3 Non-Docker QA VM_TWIN Proving Ground (Hyper-V / AWS EC2 / Azure / GCP)
# Used automatically for KERNEL & BOOT_LAYER patches and for non-container VM
# services listed in WARRANT_VM_TWIN_SERVICES (e.g., "win-pay-01,rhel-sso-01" or "*").
# Leave WARRANT_VM_TWIN_DRIVER unset to fail closed on KERNEL/BOOT_LAYER patches.
# -----------------------------------------------------------------------------
WARRANT_VM_TWIN_DRIVER=
WARRANT_VM_TWIN_SERVICES=
WARRANT_VM_TWIN_SMOKE_CMD=
WARRANT_VM_TWIN_ACCEPTANCE_CMD=

# Option A: Windows Hyper-V Host Agent (`scripts/hyperv_vm_twin_agent.ps1`)
WARRANT_HYPERV_AGENT_URL=http://host.docker.internal:8099
WARRANT_HYPERV_AGENT_TOKEN=
WARRANT_HYPERV_QA_PARENT_VHDX=D:\HyperV\Golden\win2022-qa-base.vhdx
WARRANT_HYPERV_ISOLATED_SWITCH=g1-twin-proving-private
WARRANT_HYPERV_VM_MEMORY_MB=2048
WARRANT_HYPERV_VM_CPU_COUNT=2
WARRANT_HYPERV_VM_GENERATION=2
WARRANT_HYPERV_SECURE_BOOT_TEMPLATE=MicrosoftWindows
WARRANT_HYPERV_PATCH_STAGE_DIR=

# Option B: AWS EC2 + SSM (Pure-Go AWS SigV4 + EC2 XML 2016-11-15 + SSM JSON-RPC 1.1)
WARRANT_AWS_REGION=us-east-1
WARRANT_AWS_ACCESS_KEY_ID=
WARRANT_AWS_SECRET_ACCESS_KEY=
WARRANT_AWS_SESSION_TOKEN=
WARRANT_AWS_EC2_ENDPOINT=
WARRANT_AWS_SSM_ENDPOINT=
WARRANT_AWS_TWIN_AMI_ID=
WARRANT_AWS_TWIN_SUBNET_ID=
WARRANT_AWS_TWIN_ISOLATED_SG_ID=
WARRANT_AWS_TWIN_IAM_INSTANCE_PROFILE=
WARRANT_AWS_TWIN_INSTANCE_TYPE=m6i.large
WARRANT_AWS_TWIN_OS_FAMILY=LINUX

# Option C: Azure Compute ARM (`2024-03-01` + Entra ID OAuth2 + 202 LRO Polling)
WARRANT_AZURE_ARM_ENDPOINT=https://management.azure.com
WARRANT_AZURE_AUTH_ENDPOINT=https://login.microsoftonline.com
WARRANT_AZURE_TENANT_ID=
WARRANT_AZURE_CLIENT_ID=
WARRANT_AZURE_CLIENT_SECRET=
WARRANT_AZURE_TWIN_TOKEN=
WARRANT_AZURE_TWIN_SUBSCRIPTION_ID=
WARRANT_AZURE_TWIN_RESOURCE_GROUP=
WARRANT_AZURE_TWIN_LOCATION=eastus
WARRANT_AZURE_TWIN_IMAGE_ID=
WARRANT_AZURE_TWIN_SUBNET_ID=
WARRANT_AZURE_TWIN_NSG_ID=
WARRANT_AZURE_TWIN_VM_SIZE=Standard_D2s_v5
WARRANT_AZURE_TWIN_OS_FAMILY=LINUX

# Option D: GCP Compute Engine v1 (Service Account RS256 JWT / Metadata + Serial Port 1)
WARRANT_GCP_COMPUTE_ENDPOINT=https://compute.googleapis.com
WARRANT_GCP_SERVICE_ACCOUNT_JSON=
WARRANT_GCP_TWIN_TOKEN=
WARRANT_GCP_TWIN_PROJECT=
WARRANT_GCP_TWIN_ZONE=
WARRANT_GCP_TWIN_MACHINE_IMAGE=
WARRANT_GCP_TWIN_SUBNET=
WARRANT_GCP_TWIN_MACHINE_TYPE=e2-standard-2
WARRANT_GCP_TWIN_ISOLATED_TAG=g1-twin-proving-zero-egress
WARRANT_GCP_TWIN_OS_FAMILY=LINUX

# =============================================================================
# v1.4.0 ESTATE LOADER (READ-ONLY DECISION-TIME QUERIES — STRICTLY SEPARATE FROM DISPATCH)
# =============================================================================
# Doctrine Rule 1 (Zero Replication): Warrant asks bounded questions at class drafting
# and proving time and stores ONLY summary digests in WORM estate_read_evidence.
# Doctrine Rule 2 (Credential Separation): Every *_READ_TOKEN MUST be distinct from its
# WN-8 *_TOKEN dispatch credential. Dispatch credentials are rejected on read routes,
# and read credentials are rejected on dispatch, rollback, and signing routes.
WARRANT_ESTATE_READ_TOKEN=

# Family (a) Microsoft Estate — Tier A Machine Truth (4 systems)
WARRANT_MS_INTUNE_READ_URL=
WARRANT_MS_INTUNE_READ_TOKEN=
WARRANT_AZURE_UPDATE_READ_URL=
WARRANT_AZURE_UPDATE_READ_TOKEN=
WARRANT_MS_MECM_READ_URL=
WARRANT_MS_MECM_READ_TOKEN=
WARRANT_MS_WSUS_READ_URL=
WARRANT_MS_WSUS_READ_TOKEN=

# Family (b) Cloud Inventory — Tier A Machine Truth (2 systems)
WARRANT_AWS_SSM_READ_URL=
WARRANT_AWS_SSM_READ_TOKEN=
WARRANT_GCP_OSCONFIG_READ_URL=
WARRANT_GCP_OSCONFIG_READ_TOKEN=

# Family (c) Unified Kubernetes API — Tier B Workload Truth (3 systems)
WARRANT_KUBE_READ_URL=
WARRANT_KUBE_READ_TOKEN=
WARRANT_ARGOCD_READ_URL=
WARRANT_ARGOCD_READ_TOKEN=
WARRANT_FLUX_READ_URL=
WARRANT_FLUX_READ_TOKEN=

# Family (d) Declarative REST Endpoint Managers — Tier A Machine Truth (6 systems + optional osquery)
WARRANT_TANIUM_READ_URL=
WARRANT_TANIUM_READ_TOKEN=
WARRANT_IVANTI_READ_URL=
WARRANT_IVANTI_READ_TOKEN=
WARRANT_AUTOMOX_READ_URL=
WARRANT_AUTOMOX_READ_TOKEN=
WARRANT_JAMF_PRO_READ_URL=
WARRANT_JAMF_PRO_READ_TOKEN=
WARRANT_REDHAT_SATELLITE_READ_URL=
WARRANT_REDHAT_SATELLITE_READ_TOKEN=
WARRANT_ANSIBLE_AWX_READ_URL=
WARRANT_ANSIBLE_AWX_READ_TOKEN=
WARRANT_OSQUERY_FLEET_READ_URL=
WARRANT_OSQUERY_FLEET_READ_TOKEN=

# Family (e) Vulnerability Scanners — Tier C Corroborating Census ONLY (3 systems; 0 clone sources)
WARRANT_QUALYS_READ_URL=
WARRANT_QUALYS_READ_TOKEN=
WARRANT_TENABLE_READ_URL=
WARRANT_TENABLE_READ_TOKEN=
WARRANT_RAPID7_READ_URL=
WARRANT_RAPID7_READ_TOKEN=

# ---------------------------------------------------------------------------
# Multi-Substrate Sub-Second Shield Drivers (Cloud VMs, Linux & Windows Hosts)
# Leave blank in local sandbox mode to compile declarative manifests offline.
# ---------------------------------------------------------------------------
WARRANT_SHIELD_SUBSTRATE_DEFAULT=
WARRANT_AWS_SHIELD_ENDPOINT=
WARRANT_AWS_QUARANTINE_SG_ID=
WARRANT_AZURE_SHIELD_URL=
WARRANT_AZURE_SHIELD_TOKEN=
WARRANT_AZURE_QUARANTINE_NSG=
WARRANT_GCP_SHIELD_URL=
WARRANT_GCP_SHIELD_TOKEN=
WARRANT_GCP_PROJECT_ID=
WARRANT_LINUX_SHIELD_URL=
WARRANT_LINUX_SHIELD_TOKEN=
WARRANT_WINDOWS_SHIELD_URL=
WARRANT_WINDOWS_SHIELD_TOKEN=
