# Multi-stage static Pure-Go build for Zero-Privilege Extractor (warrant-extractor)
FROM golang:1.26-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS builder
ENV GOTOOLCHAIN=auto
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/warrant-extractor ./cmd/warrant-extractor

FROM gcr.io/distroless/static:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5
COPY --from=builder /out/warrant-extractor /warrant-extractor
USER nonroot:nonroot
EXPOSE 8090
ENTRYPOINT ["/warrant-extractor"]
